# EditorConfig: https://editorconfig.org
# CoSMIC conventions: docs/conventions/EDITORCONFIG.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
spelling_language = en-AU

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.txt]
indent_style = unset
trim_trailing_whitespace = unset