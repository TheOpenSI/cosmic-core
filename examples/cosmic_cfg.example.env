# CoSMIC API / service configuration.
# `bins/setup.sh` (Linux/macOS) or `bins/setup.ps1` (Windows) copies this file
# to `apis/cores/cosmic_cfg.env` on first setup; edit the copy, not this template.
# Secrets (OPENAI_API_KEY, hf_token, hf_token_finetune) belong in the gitignored
# root `.env`, which overrides every value here.

# Docker service name / host for the Ollama server.
OLLAMA_SERVICE_NAME=cosmic-ollama

# Vector database
QDRANT_URL=http://qdrant:6333

# Chat API
CHAT_API_URL=http://backend:8000/api/v1/chatboxes/

# Services API
SERVICES_API_URL=http://backend:8000/api/v1/services/

# Emissions API
EMISSIONS_API_URL=http://backend:8000/api/v1/emissions/

# Extra CORS origins, semicolon-separated (optional).
# CORS_ALLOW_ORIGIN=

# Secrets belong in the generated apis/cores/cosmic_cfg.env (never commit that
# file, and never put real values in this template).
# OPENAI_API_KEY=
# hf_token=
# hf_token_finetune=