
# cp .env.example .env
# .env is gitignored; only this template is committed. .env is loaded at
# startup and is the single source of truth for RAG configuration: there are no
# in-code defaults, so every RAG_* key below is required and a missing key stops
# CoSMIC from starting.

# Docker service name / host for the Ollama server.
OLLAMA_SERVICE_NAME=cosmic-ollama

# Vector database
QDRANT_URL=http://qdrant:6333

# Embedding model
RAG_EMBEDDING_MODEL=gte-small

# Optional: absolute path to a directory where HuggingFace model weights are
# downloaded and cached (embedding model + cross-encoder reranker).  When set,
# HF_HOME and SENTENCE_TRANSFORMERS_HOME are also pointed here so every library respects
# the same location.  Mount this path as a Docker volume to avoid re-downloading
# weights on every container restart.
# EMBEDDING_MODEL_DIR=/app/models

# Similarity at/above which incoming content is treated as a duplicate and skipped
# when writing to the vector store
RAG_UPDATE_THRESHOLD=0.98

# Hybrid token-aware chunking.
# Chunk size and overlap are measured in *tokens* (using the embedding model's
# own tokenizer), not characters.  For gte-small (512-token context window) the
# defaults leave a comfortable margin for the query prefix in asymmetric search.
# Increase RAG_CHUNK_SIZE for denser context; decrease for finer-grained retrieval.
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32


# Number of chunks returned to the LLM after retrieval (used only when
# reranking is disabled).
RAG_TOPK=5

# Rewrite follow-up questions into standalone search queries using the chat
# history (one extra short LLM call on turns that have history).
RAG_QUERY_REWRITE=true


# Cross-encoder reranking for two stage reranking
RAG_RERANK_ENABLED=true

# Cross-encoder model used for reranking
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Number of dense candidates fetched before reranking
RAG_CANDIDATE_POOL=30

# Candidates per pass when a question with an attached file searches both the
# file and the knowledge base (two reranked passes). Lower it to cut reranker
# time; defaults to RAG_CANDIDATE_POOL when unset.
# RAG_ATTACHMENT_CANDIDATE_POOL=15

# Number of chunks kept after reranking
RAG_RERANK_TOPK=5

# Qdrant collection to use. Defaults to cosmic_collection.
# QDRANT_COLLECTION=cosmic_collection

# Hybrid search: dense vectors + BM25 (Qdrant sparse vectors with IDF), fused
# with Reciprocal Rank Fusion inside Qdrant. New collections get the BM25
# vector automatically; an existing collection must first be copied with
# scripts/migrations/migrate_to_hybrid_collection.py.
RAG_HYBRID_ENABLED=false

# Base URL the pipeline uses to reach the CoSMIC API.
OPENSI_COSMIC_API_BASE_URL=http://cosmic:3000

# Max queries per non-admin user.
MAX_QUERIES_PER_USER=5

# Chat API
CHAT_API_URL=http://backend:8000/api/v1/chatboxes/

# Services API
SERVICES_API_URL=http://backend:8000/api/v1/services/